<Window x:Class="PL.CourierMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="CourierMainWindow" Height="630" Width="800"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFEFF7FF" Offset="0"/>
                <GradientStop Color="#FFFFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Ellipse Width="450" Height="350"
         Fill="#40CDEAFE"
         HorizontalAlignment="Left"
         VerticalAlignment="Top"
         Margin="-40,-61,0,0"/>

        <Ellipse Width="300" Height="240"
         Fill="#30AED9C7"
         HorizontalAlignment="Right"
         VerticalAlignment="Bottom"
         Margin="0,0,-27,-20"/>



        <!-- שכבת איורים מעודנת -->

        <Grid>


            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Height="55"
                    Background="{StaticResource PrimaryLightBrush}"
                    Padding="20,10">

                <DockPanel LastChildFill="True">

                    <TextBlock Text="מערכת ניהול משלוחים"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextMainBrush}"
                        DockPanel.Dock="Right"
                        Margin="0,0,10,0"/>

                    <TextBlock 
                        Foreground="{StaticResource TextSoftBrush}"
                        VerticalAlignment="Center"
                        FontSize="14"
                        DockPanel.Dock="Right"
                        Text="{Binding CourierName, StringFormat= Courier:  {0}}" />

                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.3*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="0.3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" >
                    <!-- courier details -->
                    <Border  Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text=" פרטים אישיים "
                            Style="{StaticResource SectionTitleTextBlockStyle}"
                            HorizontalAlignment="Center"/>
                            <Button Content="צפיה ועדכון"
                           HorizontalAlignment="Stretch" Click="viewAndUpdateDetails"/>
                        </StackPanel>
                    </Border>
                    <Border>
                        <Button Content="בחירת הזמנה " 
                             Margin="20" Click="Button_OpenOrderListWindow"/>
                        <Button Content="היסטוריית משלוחים"  
                            Margin="20"/>
                    </Border>
                    
                </StackPanel>
                <!-- hande orders -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Visibility="{Binding CurrentCourier , 
                            Converter={StaticResource  ConvertHasOrderInProgressToVisible}}">

                            <TextBlock Text="הזמנה בטיפול"
                            Style="{StaticResource SectionTitleTextBlockStyle}"
                            HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Margin="10,2">
                                <TextBlock 
                                Text="Order ID:"
                                FontWeight="Bold"
                                HorizontalAlignment="Left" />

                                <TextBlock 
                                Text="{Binding CurrentCourier.OrderInProgress.orderId, Mode=TwoWay, 
                                                NotifyOnValidationError=true,  ValidatesOnExceptions=true}"
                                HorizontalAlignment="Left"  Grid.RowSpan="3"/>

                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="10,2">
                                    <!-- Order Type -->
                            <TextBlock Grid.Row="2" 
                                Text="Order Type:"
                                FontWeight="Bold"/>
                            <ComboBox 
                               IsEnabled="False"
                                ItemsSource="{Binding Source={StaticResource OrderTypeCollectionKey}}"
                                SelectedItem="{Binding CurrentCourier.OrderInProgress.orderType, Mode=TwoWay, 
                                NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>

                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="10,2">
                                <!-- Description -->
                                <TextBlock 
                                    Text="Description:"
                                    FontWeight="Bold" />  

                                <TextBlock Grid.Row="3"
                                    Text="{Binding CurrentCourier.OrderInProgress.description}"/>

                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="10,2">
                                    <!-- Address -->
                            <TextBlock 
                                Text="Customer Address:"
                                FontWeight="Bold"  />

                            <TextBlock 
                                Text="{Binding CurrentCourier.OrderInProgress.CustomerAddress}" />          
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="10,2">
                                <!-- Distances -->
                                <TextBlock 
                                    Text="Air Distance:"
                                    FontWeight="Bold" />

                                <TextBlock 
                                    Text="{Binding CurrentCourier.OrderInProgress.AirDistance,
                                    StringFormat={}{0} km}"/>                  

                            </StackPanel>
                            <StackPanel Orientation="Horizontal " Margin="10,2">
                                <TextBlock 
                                    Text="Actual Distance:"
                                    FontWeight="Bold" />
                                <TextBlock 
                                    Text="{Binding CurrentCourier.OrderInProgress.actualDistance,
                                    StringFormat={}{0} km}" />              
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="10,2">
                                <TextBlock 
                                    Text="Courier:"
                                    FontWeight="Bold" />

                                <TextBlock 
                                    Text="{Binding CurrentCourier.OrderInProgress.CourierFullName}"
                                    />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="10,2">
                                <TextBlock 
                                    Text="Courier Phone:"
                                    FontWeight="Bold" />

                                <TextBlock Grid.Row="8"
                                    Text="{Binding CurrentCourier.OrderInProgress.CourierPhone}"  />

                                </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="10,2" Visibility="Collapsed" >
                                <TextBlock
                                    Text="Order Status:"
                                    FontWeight="Bold"/>

                                <ComboBox IsEnabled="False"
                                    ItemsSource="{Binding Source={StaticResource OrderStatusCollectionKey}}"
                                    SelectedItem="{Binding orderInProgress.orderStatus , Mode=TwoWay, 
                                    NotifyOnValidationError=true,  ValidatesOnExceptions=true}" 
    />
                            </StackPanel>

                            <DockPanel FlowDirection="LeftToRight"  >
                                <Button Content="סיים טיפול"
                                    HorizontalAlignment="Stretch" Click="Button_EndOrderHandle" />

                                <ComboBox 
                                     HorizontalAlignment="Stretch"
                                    ItemsSource="{Binding Source={StaticResource DeliveryTerminationCollectionKey}}"
                                    SelectedItem="{Binding deliveryTerminationSelectedItem}"
                                    Margin="5,3"/>
                                
                            </DockPanel>



                        </StackPanel>

                    </StackPanel>



                </Border>

            </Grid>


        </Grid>


    </Grid>

</Window>
