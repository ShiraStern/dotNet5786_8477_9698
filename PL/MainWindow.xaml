<Window x:Class="PL.Course.CourseListWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
         DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <!--Internal, Upper Grid-->
    <Grid HorizontalAlignment="Stretch" Height="auto" Grid.Row="0" VerticalAlignment="Stretch"
          Width="auto" RenderTransformOrigin="0.416,0.48">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Content="{Binding CurrentTime}" FontWeight="Bold" FontSize="20"/>
       
        <!--קישור משתנה התצורה-->
        <StackPanel Orientation="Horizontal"
            Margin="20,50,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <Label Content="Max Range:" Width="100"/>
            <TextBox Text="{Binding Configuration.MaxRange, UpdateSourceTrigger=PropertyChanged}" Height="NaN"
           Width="50" HorizontalAlignment="Left" Canvas.Left="107" VerticalAlignment="Top"/>
            <Button Content="Save Configuration"
        HorizontalAlignment="Left"
        Margin="20,100,0,0"
        VerticalAlignment="Top"
        Click="btnSaveConfig_Click"/>

        </StackPanel>
        <Button Content="Add One Minute " HorizontalAlignment="Center" Margin="0,145,0,0" VerticalAlignment="Top" Grid.Column="1" Click="btnAddOneMinute_Click" Width="120"/>
        <Button Content="Add One Day" HorizontalAlignment="Center" Margin="0,175,0,0" VerticalAlignment="Top" Grid.Column="1" Click="btnAddOneDay_Click" Width="120"/>
        <Button Content="Add One Hour" HorizontalAlignment="Center" Margin="0,205,0,0" VerticalAlignment="Top" Grid.Column="1" Click="btnAddOneHour_Click" Width="120"/>
        <Button Content="Add One Year" HorizontalAlignment="Center" Margin="0,263,0,0" VerticalAlignment="Top" Grid.Column="1" Click="btnAddOneYear_Click" Width="120"/>
        <Button Content="Add One  Month" HorizontalAlignment="Center" Margin="0,234,0,0" VerticalAlignment="Top" Grid.Column="1" Click="btnAddOneMonth_Click" Width="120"/>
        <Button Content="Initialize" HorizontalAlignment="Left" Margin="131,130,0,0" VerticalAlignment="Top" Click="Button_Click" Width="54"/>
        <Button Content="ResetDB" HorizontalAlignment="Left" Margin="130,163,0,0" VerticalAlignment="Top" Click="Button_Click_1" Width="56"/>
        <Button Content="Handle Courier" HorizontalAlignment="Left" Margin="132,249,0,0" VerticalAlignment="Top" Click="Button_Click_3"/>
        <Button Content="Handle Orders" HorizontalAlignment="Left" Margin="133,215,0,0" VerticalAlignment="Top" Click="Button_Click_2" RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="1.391"/>
                    <RotateTransform/>
                    <TranslateTransform X="0.243"/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>
        <Button Content="The list view" HorizontalAlignment="Left" Margin="350,175,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.654,0.493" Grid.ColumnSpan="2" Height="35" Width="85" Click="Button_Click_7"/>
    </Grid>

</Window>
