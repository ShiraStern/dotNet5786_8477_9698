<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="מערכת ניהול משלוחים"
        Height="520" Width="950"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            --><!-- כותרת עליונה --><!--
            <RowDefinition Height="*"/>
            --><!-- גוף המסך --><!--
        </Grid.RowDefinitions>

        --><!-- Top Bar --><!--
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryBrush}"
                Padding="20,10">
            <DockPanel LastChildFill="True">
                <TextBlock Text="מערכת ניהול משלוחים"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           DockPanel.Dock="Right"
                           Margin="0,0,10,0"/>
                <TextBlock Text="Panel מנהל"
                           Foreground="#CCFFFFFF"
                           VerticalAlignment="Center"
                           FontSize="14"
                           DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

        --><!-- Main Content --><!--
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                --><!-- תצורה --><!--
                <ColumnDefinition Width="1.5*"/>
                --><!-- ניהול בסיס נתונים --><!--
                <ColumnDefinition Width="2*"/>
                --><!-- שעון מערכת --><!--
            </Grid.ColumnDefinitions>

            --><!-- כרטיס: תצורת מערכת --><!--
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="הגדרות מערכת"
                               Style="{StaticResource SectionTitleTextBlockStyle}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Label Content="Max Range (km):"
                               VerticalAlignment="Center"
                               Width="130"/>
                        <TextBox Width="80"
                                 Text="{Binding Configuration.MaxRange, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="Save Configuration"
                                Click="btnSaveConfig_Click"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            --><!-- כרטיס: ניהול בסיס נתונים ושליטה ביישויות --><!--
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="ניהול מאגר נתונים"
                               Style="{StaticResource SectionTitleTextBlockStyle}"/>

                    <StackPanel>
                        <Button Content="Initialize DB"
                                Click="Button_InitializeDB"
                                HorizontalAlignment="Stretch"/>

                        <Button Content="Reset DB"
                                Click="Button_ResetDB"
                                HorizontalAlignment="Stretch"
                                Margin="6,4,6,16"/>

                        <Separator/>

                        <TextBlock Text="ניהול ישויות"
                                   Margin="0,12,0,4"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"/>

                        <Button Content="Handle Courier"
                                Click="btnHandleCourier"
                                HorizontalAlignment="Stretch"/>

                        <Button Content="Handle Orders"
                                Click="btnHandleOrders"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            --><!-- כרטיס: שעון מערכת --><!--
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="שעון מערכת"
                                   Style="{StaticResource SectionTitleTextBlockStyle}"/>

                        <TextBlock Text="{Binding CurrentTime}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <UniformGrid Grid.Row="1"
                                 Columns="2"
                                 Rows="3"
                                 Margin="0,20,0,0">
                        <Button Content="Add One Minute"
                                Click="btnAddOneMinute_Click"/>
                        <Button Content="Add One Hour"
                                Click="btnAddOneHour_Click"/>
                        <Button Content="Add One Day"
                                Click="btnAddOneDay_Click"/>
                        <Button Content="Add One Month"
                                Click="btnAddOneMonth_Click"/>
                        <Button Content="Add One Year"
                                Click="btnAddOneYear_Click"
                                Grid.ColumnSpan="2"/>
                    </UniformGrid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>-->
<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="מערכת ניהול משלוחים"
        Height="520" Width="950"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <!-- רקע כללי עם גרדיאנט פסטלי -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFEFF7FF" Offset="0"/>
                <GradientStop Color="#FFFFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- שכבת איורים מעודנת -->
        <Ellipse Width="450" Height="350"
                 Fill="#40CDEAFE"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-80 -120 0 0"/>

        <Ellipse Width="300" Height="240"
                 Fill="#30AED9C7"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0 0 -80 -60"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- פס עליון פסטלי אחיד -->
            <Border Grid.Row="0"
                    Height="55"
                    Background="{StaticResource PrimaryLightBrush}"
                    Padding="20,10">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="מערכת ניהול משלוחים"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextMainBrush}"
                               DockPanel.Dock="Right"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="Panel מנהל"
                               Foreground="{StaticResource TextSoftBrush}"
                               VerticalAlignment="Center"
                               FontSize="14"
                               DockPanel.Dock="Right"/>
                </DockPanel>
            </Border>

            <!-- גוף המסך -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- כרטיס: תצורת מערכת -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="הגדרות מערכת"
                                   Style="{StaticResource SectionTitleTextBlockStyle}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Label Content="Max Range (km):"
                                   VerticalAlignment="Center"
                                   Width="130"/>
                            <TextBox Width="80"
                                     Text="{Binding Configuration.MaxRange, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Save Configuration"
                                    Click="btnSaveConfig_Click"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- כרטיס: ניהול בסיס נתונים ושליטה ביישויות -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="ניהול מאגר נתונים"
                                   Style="{StaticResource SectionTitleTextBlockStyle}"/>

                        <StackPanel>
                            <Button Content="Initialize DB"
                                    Click="Button_InitializeDB"
                                    HorizontalAlignment="Stretch"/>

                            <Button Content="Reset DB"
                                    Click="Button_ResetDB"
                                    HorizontalAlignment="Stretch"
                                    Margin="6,4,6,16"/>

                            <Separator/>

                            <TextBlock Text="ניהול ישויות"
                                       Margin="0,12,0,4"
                                       Foreground="{StaticResource TextSoftBrush}"
                                       FontWeight="SemiBold"/>

                            <Button Content="Handle Courier"
                                    Click="btnHandleCourier"
                                    HorizontalAlignment="Stretch"/>

                            <Button Content="Handle Orders"
                                    Click="btnHandleOrders"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- כרטיס: שעון מערכת -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="שעון מערכת"
                                       Style="{StaticResource SectionTitleTextBlockStyle}"/>

                            <TextBlock Text="{Binding CurrentTime}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryDarkBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <UniformGrid Grid.Row="1"
                                     Columns="2"
                                     Rows="3"
                                     Margin="0,20,0,0">
                            <Button Content="Add One Minute"
                                    Click="btnAddOneMinute_Click"/>
                            <Button Content="Add One Hour"
                                    Click="btnAddOneHour_Click"/>
                            <Button Content="Add One Day"
                                    Click="btnAddOneDay_Click"/>
                            <Button Content="Add One Month"
                                    Click="btnAddOneMonth_Click"/>
                            <Button Content="Add One Year"
                                    Click="btnAddOneYear_Click"
                                    Grid.ColumnSpan="2"/>
                        </UniformGrid>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</Window>
