<Window x:Class="PL.OpenOrderListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Order"
        mc:Ignorable="d"
        Title="Open Order List"
        Height="640" Width="900"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Card with grid -->
        </Grid.RowDefinitions>

        <!-- כותרת עליונה -->
        <TextBlock Grid.Row="0"
                   Text="רשימת הזמנות"
                   Style="{StaticResource SectionTitleTextBlockStyle}"
                   FontSize="20"
                   Margin="0,0,0,10"
                   HorizontalAlignment="Right"/>

        <!-- Card עיקרי -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Filters -->
                    <RowDefinition Height="*"/>
                    <!-- DataGrid -->
                    <RowDefinition Height="Auto"/>
                    <!-- Buttons -->
                </Grid.RowDefinitions>

                <!-- FILTER SECTION -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Filter by:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                    <ComboBox Grid.Column="1"
                              MinWidth="180"
                              SelectedValue="{Binding Path=filterOrderStatus, Mode=TwoWay}"
                              ItemsSource="{Binding Source={StaticResource   }}"
                              SelectionChanged="OrderStatusFilterComboBox"/>

                    <ComboBox Grid.Column="2"
                              MinWidth="180"
                              SelectedValue="{Binding Path=filterOrderOrderType, Mode=TwoWay}"
                              Visibility="Collapsed"
                              ItemsSource="{Binding Source={StaticResource OrderTypeCollectionKey}}"
                              SelectionChanged="OrderTypeFilterComboBox"/>

                </Grid>

                <!-- ORDERS LIST -->
                <DataGrid x:Name="OrderListView"
                          Grid.Row="1"
                          Margin="0,0,0,10"
                          ItemsSource="{Binding OrderInList}"
                          AutoGenerateColumns="False"
                          SelectedItem="{Binding selectedOrder}"
                          MouseDoubleClick="selectOrder_MouseDoubleClick"
                          IsReadOnly="True"
                          ColumnWidth="auto">

                    <DataGrid.Columns>

                        <DataGridTextColumn Binding="{Binding DeliveryId}"
                                            Header="Delivery ID"
                                            Width="auto" />

                        <DataGridTextColumn Binding="{Binding OrderId}"
                                            Header="Order ID"
                                            Width="auto" />

                        <DataGridTextColumn Binding="{Binding DeliveryType}"
                                            Header="Delivery Type"
                                            Width="auto" />

                        <DataGridTextColumn Binding="{Binding AirDistance}"
                                            Header="Air Distance"
                                            Width="auto" />

                        <!-- Order Status עם "קובייה" באותו גודל + צבעים עדינים -->
                        <DataGridTemplateColumn Header="Order Status" Width="auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Border Width="95"
                                            Height="30"
                                            CornerRadius="6"
                                            Padding="3"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                        <TextBlock Text="{Binding OrderStatus}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontWeight="SemiBold" />

                                        <Border.Style>
                                            <Style TargetType="Border">

                                                <!-- ברירת מחדל -->
                                                <Setter Property="Background" Value="Gainsboro"/>
                                                <Setter Property="BorderBrush" Value="LightGray"/>
                                                <Setter Property="BorderThickness" Value="1"/>

                                                <Style.Triggers>

                                                    <!-- Open -->
                                                    <DataTrigger Binding="{Binding OrderStatus}" Value="Open">
                                                        <Setter Property="Background" Value="AliceBlue"/>
                                                    </DataTrigger>

                                                    <!-- InTreatment -->
                                                    <DataTrigger Binding="{Binding OrderStatus}" Value="InTreatment">
                                                        <Setter Property="Background" Value="LemonChiffon"/>
                                                    </DataTrigger>

                                                    <!-- Delivered -->
                                                    <DataTrigger Binding="{Binding OrderStatus}" Value="Delivered">
                                                        <Setter Property="Background" Value="Honeydew"/>
                                                    </DataTrigger>

                                                    <!-- Refused -->
                                                    <DataTrigger Binding="{Binding OrderStatus}" Value="Refused">
                                                        <Setter Property="Background" Value="Moccasin"/>
                                                    </DataTrigger>

                                                    <!-- Cancelled -->
                                                    <DataTrigger Binding="{Binding OrderStatus}" Value="Cancelled">
                                                        <Setter Property="Background" Value="MistyRose"/>
                                                    </DataTrigger>

                                                    <!-- All (אם מופיע) -->
                                                    <DataTrigger Binding="{Binding OrderStatus}" Value="All">
                                                        <Setter Property="Background" Value="Gainsboro"/>
                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>
                                        </Border.Style>

                                    </Border>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Binding="{Binding ScheduleStatus}"
                                            Header="Schedule Status"
                                            Width="auto" />

                        <DataGridTextColumn Header="Time Left"
                                            Width="auto"
                                            Binding="{Binding DeliveryTimeLeft,
                                                              Converter={StaticResource TimeSpanToDaysHoursConverterKey}}" />

                        <DataGridTextColumn Header="Handling Time"
                                            Width="auto"
                                            Binding="{Binding TotalHandlingTime,
                                                              Converter={StaticResource TimeSpanToDaysHoursConverterKey}}" />

                        <DataGridTextColumn Binding="{Binding TotalDeliveries}"
                                            Header="Total Deliveries"
                                            Width="auto" />

                        <DataGridTemplateColumn Header="" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="cancel"
                                            Width="60"
                                            Click="DeleteOrder_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

                <!-- BUTTONS -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Add Order"
                            Width="130" Height="38"
                            Click="AddOrder_Click"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
