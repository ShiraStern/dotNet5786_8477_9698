
<Application x:Class="PL.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PL"
             StartupUri="MainWindow.xaml">

    <Application.Resources>
        <ResourceDictionary>

            <!-- 🎨 צבעים פסטל רכים -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#FF8EC5FF"/>
            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF76B1E8"/>
            <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FFCDEAFE"/>

            <SolidColorBrush x:Key="AccentBrush" Color="#FFAED9C7"/>

            <SolidColorBrush x:Key="BackgroundBrush" Color="#FFF8FBFF"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF"/>

            <SolidColorBrush x:Key="TextMainBrush" Color="#FF243447"/>
            <SolidColorBrush x:Key="TextSoftBrush" Color="#FF6A7A89"/>

            <SolidColorBrush x:Key="BorderSoftBrush" Color="#FFE2ECF3"/>

            <!-- 🪟 Window style כללי -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="15"/>
            </Style>

            <!-- 🧩 עיצוב כרטיסים (Card) -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="25"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="15"/>
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="25"
                                          ShadowDepth="3"
                                          Opacity="0.12"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 🔘 עיצוב כפתור פסטל עדין -->
            <Style TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Margin" Value="6"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B"
                                    CornerRadius="22"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="Background"
                                            Value="{StaticResource PrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="B" Property="Background"
                                            Value="{StaticResource PrimaryDarkBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- DataGrid פסטלי עדין -->
            <Style TargetType="DataGrid">
                <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
                <Setter Property="RowBackground" Value="White"/>
                <Setter Property="AlternatingRowBackground" Value="{StaticResource PrimaryLightBrush}"/>
            </Style>

            <!-- כותרות אזור/כרטיס -->
            <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <local:CourierActivityCollection x:Key="CourierActivityCollectionKey"/>
            <local:OrderStatusCollectionForOrder x:Key="OrderStatusCollectionKey"/>
            <local:DeliveryTypeCollection x:Key="DeliveryTypeCollectionKey"/>
            <local:OrederFilterCollection x:Key="OrederFilterCollectionKey"/>

        </ResourceDictionary>
    </Application.Resources>

</Application>
