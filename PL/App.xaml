<Application x:Class="PL.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PL"
             StartupUri="MainWindow.xaml">

    <Application.Resources>
        <ResourceDictionary>

            --><!-- 🎨 צבעים בסיסיים (תכלת יוקרתי) --><!--
            <Color x:Key="Color.Primary">#FF2F80ED</Color>
            --><!-- תכלת עיקרי --><!--
            <Color x:Key="Color.PrimaryLight">#FF6FB5FF</Color>
            --><!-- תכלת בהיר --><!--
            <Color x:Key="Color.PrimaryDark">#FF1C4E9A</Color>
            --><!-- תכלת כהה --><!--
            <Color x:Key="Color.Accent">#FF00BFA6</Color>
            --><!-- ירקרק עדין לאייקונים/דגשים --><!--

            <Color x:Key="Color.Background">#FFF4F8FF</Color>
            --><!-- רקע כללי רך --><!--
            <Color x:Key="Color.CardBackground">#FFFFFFFF</Color>
            --><!-- רקע כרטיסים --><!--
            <Color x:Key="Color.Border">#FFD0E4F7</Color>
            --><!-- מסגרת עדינה --><!--
            <Color x:Key="Color.TextPrimary">#FF102A43</Color>
            --><!-- טקסט כהה --><!--
            <Color x:Key="Color.TextSecondary">#FF627D98</Color>
            --><!-- טקסט משני --><!--
            <Color x:Key="Color.Disabled">#FFCBD2E1</Color>
            --><!-- מצב מנוטרל -->

            <!-- 🖌 מברשות --><!--
            <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Color.Primary}"/>
            <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource Color.PrimaryLight}"/>
            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource Color.PrimaryDark}"/>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Color.Accent}"/>

            <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Color.Background}"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource Color.CardBackground}"/>
            <SolidColorBrush x:Key="BorderBrushColor" Color="{StaticResource Color.Border}"/>

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Color.TextPrimary}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Color.TextSecondary}"/>
            <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource Color.Disabled}"/>

            --><!-- 🪟 Style כללי לכל ה-Windows --><!--
            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="WindowStartupLocation" Value="CenterScreen"/>
            </Style>

            --><!-- 🧾 כרטיס (Card) כללי לשימוש חוזר --><!--
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Margin" Value="10"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="8"
                                          ShadowDepth="2"
                                          Opacity="0.12"/>
                    </Setter.Value>
                </Setter>
            </Style>

            --><!-- כותרות אזור / כרטיס --><!--
            <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            --><!-- 🏷 Label בסיסי --><!--
            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,4,0,4"/>
            </Style>

            --><!-- ✏ TextBox מעוצב --><!--
            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Background" Value="#FFF9FCFF"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="Margin" Value="0,4,0,4"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            --><!-- ⬇ ComboBox מעוצב --><!--
            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Background" Value="#FFF9FCFF"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="Margin" Value="0,4,0,4"/>
            </Style>

            --><!-- 🔘 Button תכלת יוקרתי --><!--
            <Style TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Margin" Value="6"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background"
                                            Value="{StaticResource PrimaryLightBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background"
                                            Value="{StaticResource PrimaryDarkBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background"
                                            Value="{StaticResource DisabledBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            --><!-- 📋 DataGrid תכלת --><!--
            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="RowBackground" Value="White"/>
                <Setter Property="AlternatingRowBackground" Value="#FFF0F7FF"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrushColor}"/>
                <Setter Property="VerticalGridLinesBrush" Value="{StaticResource BorderBrushColor}"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="6,4"/>
            </Style>

            --><!-- פה אפשר בהמשך להוסיף Styles ל-DataGridRow עם צבע לפי ENUM באמצעות Converter -->

            <!-- ⚙️ המשאבים שהיו לך כבר (לא נוגעים בהם) --><!--
            <local:CourierActivityCollection x:Key="CourierActivityCollectionKey" />
            <local:OrderStatusCollection x:Key="OrderStatusCollectionKey" />
            <local:OrderStatusCollection x:Key="DeliveryTypeCollectionKey" />

        </ResourceDictionary>
    </Application.Resources>
</Application>-->
<Application x:Class="PL.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

    <Application.Resources>
        <ResourceDictionary>

            <!-- 🎨 צבעים פסטל רכים -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#FF8EC5FF"/>
            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF76B1E8"/>
            <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FFCDEAFE"/>

            <SolidColorBrush x:Key="AccentBrush" Color="#FFAED9C7"/>

            <SolidColorBrush x:Key="BackgroundBrush" Color="#FFF8FBFF"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF"/>

            <SolidColorBrush x:Key="TextMainBrush" Color="#FF243447"/>
            <SolidColorBrush x:Key="TextSoftBrush" Color="#FF6A7A89"/>

            <SolidColorBrush x:Key="BorderSoftBrush" Color="#FFE2ECF3"/>

            <!-- 🪟 Window style כללי -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="15"/>
            </Style>

            <!-- 🧩 עיצוב כרטיסים (Card) -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="25"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="15"/>
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="25"
                                          ShadowDepth="3"
                                          Opacity="0.12"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 🔘 עיצוב כפתור פסטל עדין -->
            <Style TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Margin" Value="6"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B"
                                    CornerRadius="22"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="Background"
                                            Value="{StaticResource PrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="B" Property="Background"
                                            Value="{StaticResource PrimaryDarkBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- DataGrid פסטלי עדין -->
            <Style TargetType="DataGrid">
                <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
                <Setter Property="RowBackground" Value="White"/>
                <Setter Property="AlternatingRowBackground" Value="{StaticResource PrimaryLightBrush}"/>
            </Style>

            <!-- כותרות אזור/כרטיס -->
            <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>

</Application>
