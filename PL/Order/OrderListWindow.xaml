<Window x:Class="PL.Order.OrderListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Order"
        mc:Ignorable="d"
        Title="רשימת הזמנות"
        Height="640" Width="900"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Card with grid -->
        </Grid.RowDefinitions>

        <!-- כותרת עליונה -->
        <TextBlock Grid.Row="0"
                   Text="רשימת הזמנות"
                   Style="{StaticResource SectionTitleTextBlockStyle}"
                   FontSize="20"
                   Margin="0,0,0,10"/>

        <!-- Card עיקרי -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Filters -->
                    <RowDefinition Height="*"/>
                    <!-- DataGrid -->
                    <RowDefinition Height="Auto"/>
                    <!-- Buttons -->
                </Grid.RowDefinitions>

                <!-- FILTER SECTION -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Filter by status:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                    <ComboBox Grid.Column="1"
                              MinWidth="180"
                              SelectedValue="{Binding Path=filterOrdersByProp, Mode=TwoWay}"
                              ItemsSource="{Binding Source={StaticResource OrderStatusCollectionKey}}"
                              SelectionChanged="OrderFilterComboBox_SelectionChanged"/>
                </Grid>

                <!-- ORDERS LIST -->
                <DataGrid x:Name="OrderListView"
                          Grid.Row="1"
                          Margin="0,0,0,10"
                          ItemsSource="{Binding OrderInList}"
                          AutoGenerateColumns="False"
                          SelectedItem="{Binding selectedOrder}"
                          MouseDoubleClick="selectCourier_MouseDoubleClick"
                          IsReadOnly="True">

                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding DeliveryId}" Header="Delivery ID" Width="*" />
                        <DataGridTextColumn Binding="{Binding OrderId}" Header="Order ID" Width="*" />
                        <DataGridTextColumn Binding="{Binding DeliveryType}" Header="Delivery Type" Width="*" />
                        <DataGridTextColumn Binding="{Binding AirDistance}" Header="Air Distance" Width="*" />
                        <DataGridTextColumn Binding="{Binding OrderStatus}" Header="Order Status" Width="*" />
                        <DataGridTextColumn Binding="{Binding ScheduleStatus}" Header="Schedule Status" Width="*" />

                        <DataGridTextColumn Header="Time Left"
                                            Width="*"
                                            Binding="{Binding DeliveryTimeLeft, StringFormat={}{0:hh\\:mm}}"/>

                        <DataGridTextColumn Header="Handling Time"
                                            Width="*"
                                            Binding="{Binding TotalHandlingTime, StringFormat={}{0:hh\\:mm}}"/>

                        <DataGridTextColumn Binding="{Binding TotalDeliveries}" Header="Total Deliveries" Width="*" />

                        <DataGridTemplateColumn Header="" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Delete"
                                            Width="60"
                                            Click="DeleteOrder_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- BUTTONS -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Add Order"
                            Width="130" Height="38"
                            Click="AddOrder_Click"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
