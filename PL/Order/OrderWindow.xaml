<Window x:Class="PL.Order.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="OrderWindow" Height="650" Width="800">

    <Window.Resources>

        <!-- רשימות Enum למסך Order -->
        <local:OrderTypeCollection x:Key="OrderTypeList" />
        <local:OrderStatusEnumCollection x:Key="OrderStatusList" />
        <local:ScheduleStatusCollection x:Key="ScheduleStatusList" />

        <!-- קונברטרים משלב 9ג -->
        <local:ConvertUpdateToTrue x:Key="ConvertUpdateToTrueKey" />
        <local:ConvertUpdateToVisible x:Key="ConvertUpdateToVisibleKey" />

    </Window.Resources>


        <Grid Margin="20">

        <!-- עמודות -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- שורות -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- ID -->
            <RowDefinition Height="Auto"/>
            <!-- OrderType -->
            <RowDefinition Height="Auto"/>
            <!-- VerbalDescription -->
            <RowDefinition Height="Auto"/>
            <!-- FullAddress -->
            <RowDefinition Height="Auto"/>
            <!-- Latitude -->
            <RowDefinition Height="Auto"/>
            <!-- Longitude -->
            <RowDefinition Height="Auto"/>
            <!-- AirDistance -->
            <RowDefinition Height="Auto"/>
            <!-- FullName -->
            <RowDefinition Height="Auto"/>
            <!-- Phone -->
            <RowDefinition Height="Auto"/>
            <!-- OrderProperties -->
            <RowDefinition Height="Auto"/>
            <!-- OpeningTime -->
            <RowDefinition Height="Auto"/>
            <!-- Estimated -->
            <RowDefinition Height="Auto"/>
            <!-- MaxDelivery -->
            <RowDefinition Height="Auto"/>
            <!-- OrderStatus -->
            <RowDefinition Height="Auto"/>
            <!-- ScheduleStatus -->
            <RowDefinition Height="Auto"/>
            <!-- TimeLeft -->
        </Grid.RowDefinitions>


        <!-- ID -->
        <Label Grid.Row="0" Grid.Column="0" Content="Order ID:"/>
        <TextBox Grid.Row="0" Grid.Column="2"
         Text="{Binding CurrentOrder.ID}"
         IsReadOnly="{Binding ButtonText, Converter={StaticResource ConvertUpdateToTrueKey}}"/>


        <!-- OrderType -->
        <Label Grid.Row="1" Grid.Column="0" Content="Order Type:"/>
        <ComboBox Grid.Row="1" Grid.Column="2"
                  ItemsSource="{Binding Source={StaticResource OrderStatusList}}"
                  SelectedItem="{Binding CurrentOrder.OrderType}"
                  Width="540"/>


        <!-- VerbalDescription -->
        <Label Grid.Row="2" Grid.Column="0" Content="Description:"/>
        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding CurrentOrder.VerbalDescription}"/>


        <!-- FullAddressOfTheOrder -->
        <Label Grid.Row="3" Grid.Column="0" Content="Address:"/>
        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding CurrentOrder.FullAddressOfTheOrder}"/>


        <!-- Latitude -->
        <Label Grid.Row="4" Grid.Column="0" Content="Latitude:"/>
        <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding CurrentOrder.Latitude}" IsReadOnly="True"/>


        <!-- Longitude -->
        <Label Grid.Row="5" Grid.Column="0" Content="Longitude:"/>
        <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding CurrentOrder.Longitude}" IsReadOnly="True"/>


        <!-- AirDistance -->
        <Label Grid.Row="6" Grid.Column="0" Content="Air Distance:"/>
        <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding CurrentOrder.AirDistance}"/>


        <!-- FullNameOfTheInviter -->
        <Label Grid.Row="7" Grid.Column="0" Content="Inviter Name:"/>
        <TextBox Grid.Row="7" Grid.Column="2" Text="{Binding CurrentOrder.FullNameOfTheInviter}"/>


        <!-- OrderersPhoneNumber -->
        <Label Grid.Row="8" Grid.Column="0" Content="Inviter Phone:"/>
        <TextBox Grid.Row="8" Grid.Column="2" Text="{Binding CurrentOrder.OrderersPhoneNumber}"/>


        <!-- OrderProperties -->
        <Label Grid.Row="9" Grid.Column="0" Content="Order Properties:"/>
        <ComboBox Grid.Row="9" Grid.Column="2"
                  ItemsSource="{Binding OrderPropertiesList}"
                  SelectedItem="{Binding CurrentOrder.OrderProperties}"/>


        <!-- OrderOpeningTime -->
        <Label Grid.Row="10" Grid.Column="0" Content="Opening Time:"
       Visibility="{Binding ButtonText, Converter={StaticResource ConvertUpdateToVisibleKey}}"/>

        <DatePicker Grid.Row="10" Grid.Column="2"
            SelectedDate="{Binding CurrentOrder.OrderOpeningTime}"
            Visibility="{Binding ButtonText, Converter={StaticResource ConvertUpdateToVisibleKey}}"/>


        <!-- EstimatedDeliveryTime -->
        <Label Grid.Row="11" Grid.Column="0" Content="Estimated Delivery:"/>
        <DatePicker Grid.Row="11" Grid.Column="2"
                    SelectedDate="{Binding CurrentOrder.EstimatedDeliveryTime}"/>


        <!-- MaximumDeliveryTime -->
        <Label Grid.Row="12" Grid.Column="0" Content="Maximum Delivery:"/>
        <DatePicker Grid.Row="12" Grid.Column="2"
                    SelectedDate="{Binding CurrentOrder.MaximumDeliveryTime}"/>


        <!-- OrderStatus -->
        <Label Grid.Row="13" Grid.Column="0" Content="Order Status:"/>
        <ComboBox Grid.Row="13" Grid.Column="2"
                  ItemsSource="{Binding OrderStatusList}"
                  SelectedItem="{Binding CurrentOrder.OrderStatus}"/>


        <!-- ScheduleStatus -->
        <Label Grid.Row="14" Grid.Column="0" Content="Schedule Status:"/>
        <ComboBox Grid.Row="14" Grid.Column="2"
                  ItemsSource="{Binding ScheduleStatusList}"
                  SelectedItem="{Binding CurrentOrder.ScheduleStatus}"/>


        <!-- TimeLeftToCompleteOrder -->
        <Label Grid.Row="15" Grid.Column="0" Content="Time Left:"/>
        <TextBox Grid.Row="15" Grid.Column="2"
                 Text="{Binding CurrentOrder.TimeLeftToCompleteOrder}"/>


        <!-- כפתור שמירה -->
        <Button Grid.Row="12" Grid.Column="2"
                Content="{Binding ButtonText}"
                Click="btnAddUpdate_Click"
                Width="120" Height="35"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"/>

    </Grid>
</Window>
