<Window x:Class="PL.Order.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="פרטי הזמנה"
        Height="650" Width="900"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <Window.Resources>
        <!-- רשימות Enum למסך Order -->
        <local:OrderTypeCollection x:Key="OrderTypeList" />
        <local:OrderStatusCollectionForOrder x:Key="OrderStatusList" />
        <local:ScheduleStatusCollection x:Key="ScheduleStatusList" />

        <!-- קונברטרים משלב 9ג -->
        <local:ConvertUpdateToTrue x:Key="ConvertUpdateToTrueKey" />
        <local:ConvertUpdateToVisible x:Key="ConvertUpdateToVisibleKey" />
    </Window.Resources>

    <Grid Margin="20">
        <Border Style="{StaticResource CardStyle}">
            <Grid Margin="10">
                <!-- עמודות -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- שורות -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- כותרת -->
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <!-- ID -->
                    <RowDefinition Height="Auto"/>
                    <!-- OrderType -->
                    <RowDefinition Height="Auto"/>
                    <!-- VerbalDescription -->
                    <RowDefinition Height="Auto"/>
                    <!-- FullAddress -->
                    <RowDefinition Height="Auto"/>
                    <!-- Latitude -->
                    <RowDefinition Height="Auto"/>
                    <!-- Longitude -->
                    <RowDefinition Height="Auto"/>
                    <!-- AirDistance -->
                    <RowDefinition Height="Auto"/>
                    <!-- FullName -->
                    <RowDefinition Height="Auto"/>
                    <!-- Phone -->
                    <RowDefinition Height="Auto"/>
                    <!-- OrderProperties -->
                    <RowDefinition Height="Auto"/>
                    <!-- OpeningTime -->
                    <RowDefinition Height="Auto"/>
                    <!-- Estimated -->
                    <RowDefinition Height="Auto"/>
                    <!-- MaxDelivery -->
                    <RowDefinition Height="Auto"/>
                    <!-- OrderStatus -->
                    <RowDefinition Height="Auto"/>
                    <!-- ScheduleStatus -->
                    <RowDefinition Height="Auto"/>
                    <!-- TimeLeft -->
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Button -->
                </Grid.RowDefinitions>

                <!-- כותרת -->
                <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                           Text="{Binding HeaderTitle, FallbackValue=Order Details}"
                           Style="{StaticResource SectionTitleTextBlockStyle}"
                           FontSize="20"/>

                <!-- ID -->
                <Label Grid.Row="2" Grid.Column="0" Content="Order ID:"/>
                <Label Grid.Row="2" Grid.Column="2"
                         Content="{Binding CurrentOrder.ID, Mode=TwoWay, 
                            NotifyOnValidationError=true,  ValidatesOnExceptions=true}"/>
                          

                <!-- OrderType -->
                <Label Grid.Row="3" Grid.Column="0" Content="Order Type:"/>
                <ComboBox Grid.Row="3" Grid.Column="2"
                          ItemsSource="{Binding Source={StaticResource OrderTypeList}}"
                          SelectedItem="{Binding CurrentOrder.OrderType}"
                          SelectedValue="{Binding CurrentOrder.OrderType, Mode=TwoWay, NotifyOnValidationError=true,ValidatesOnExceptions=true}" 
                          Width="540"/>

                <!-- VerbalDescription -->
                <Label Grid.Row="4" Grid.Column="0" Content="Description:"/>
                <TextBox Grid.Row="4" Grid.Column="2"
                         Text="{Binding CurrentOrder.VerbalDescription, Mode=TwoWay, 
                            NotifyOnValidationError=true,  ValidatesOnExceptions=true}"
                         AcceptsReturn="True"
                         Height="60"
                         VerticalScrollBarVisibility="Auto"/>

                <!-- FullAddressOfTheOrder -->
                <Label Grid.Row="5" Grid.Column="0" Content="Address:"/>
                <TextBox Grid.Row="5" Grid.Column="2"
                         Text="{Binding CurrentOrder.FullAddressOfTheOrder, Mode=TwoWay, 
                            NotifyOnValidationError=true,  ValidatesOnExceptions=true}"/>

                <!-- Latitude -->
                <Label Grid.Row="6" Grid.Column="0" Content="Latitude:" Visibility="Collapsed"/>
                <TextBox Grid.Row="6" Grid.Column="2"
                         Text="{Binding CurrentOrder.Latitude}"
                         IsReadOnly="True"
                         Visibility="Collapsed"/>

                <!-- Longitude -->
                <Label Grid.Row="7" Grid.Column="0" Content="Longitude:" Visibility="Collapsed"/>
                <TextBox Grid.Row="7" Grid.Column="2"
                         Text="{Binding CurrentOrder.Longitude}"
                         IsReadOnly="True"
                         Visibility="Collapsed"/>

                <!-- AirDistance -->
                <Label Grid.Row="8" Grid.Column="0" Content="Air Distance:" Visibility="Collapsed"/>
                <TextBox Grid.Row="8" Grid.Column="2"
                         Text="{Binding CurrentOrder.AirDistance}" Visibility="Collapsed"/>

                <!-- FullNameOfTheInviter -->
                <Label Grid.Row="9" Grid.Column="0" Content="Inviter Name:"/>
                <TextBox Grid.Row="9" Grid.Column="2"
                         Text="{Binding CurrentOrder.FullNameOfTheInviter, Mode=TwoWay, 
                            NotifyOnValidationError=true,  ValidatesOnExceptions=true}"/>

                <!-- OrderersPhoneNumber -->
                <Label Grid.Row="10" Grid.Column="0" Content="Inviter Phone:"/>
                <TextBox Grid.Row="10" Grid.Column="2"
                         Text="{Binding CurrentOrder.OrderersPhoneNumber}"/>

                <!-- OrderProperties -->
                <Label Grid.Row="11" Grid.Column="0" Content="Order Properties:"/>
                <ComboBox Grid.Row="11" Grid.Column="2"
                          ItemsSource="{Binding Source={StaticResource OrderPropertiesCollectionKey}}"
                          SelectedItem="{Binding CurrentOrder.OrderProperties}"/>

                <!-- OrderOpeningTime -->
                <Label Grid.Row="12" Grid.Column="0"
                       Content="Opening Time:"
                       Visibility="{Binding ButtonText, Converter={StaticResource ConvertUpdateToVisibleKey}}"/>

                <DatePicker Grid.Row="12" Grid.Column="2"
                            SelectedDate="{Binding CurrentOrder.OrderOpenDate, Mode=TwoWay, 
                                NotifyOnValidationError=true,  ValidatesOnExceptions=true}"
                            Visibility="{Binding ButtonText, Converter={StaticResource ConvertUpdateToVisibleKey}}"/>

                <!-- EstimatedDeliveryTime -->
                <Label Grid.Row="13" Grid.Column="0" Content="Estimated Delivery:" />
                <DatePicker Grid.Row="13" Grid.Column="2"
                            SelectedDate="{Binding CurrentOrder.EstimatedDeliveryDate, Mode=TwoWay, 
                                    NotifyOnValidationError=true,  ValidatesOnExceptions=true}" 
                                    IsEnabled="False"/>

                <!-- MaximumDeliveryTime -->
                <Label Grid.Row="14" Grid.Column="0" Content="Maximum Delivery:"/>
                <DatePicker Grid.Row="14" Grid.Column="2"
                            SelectedDate="{Binding CurrentOrder.MaximumDeliveryDate, Mode=TwoWay, 
                            NotifyOnValidationError=true,  ValidatesOnExceptions=true}"
                            IsEnabled="False"/>

                <!-- OrderStatus -->
                <Label Grid.Row="15" Grid.Column="0" Content="Order Status:"/>
                <ComboBox Grid.Row="15" Grid.Column="2"
                          ItemsSource="{Binding Source={StaticResource OrderStatusCollectionKey}}"
                          SelectedItem="{Binding CurrentOrder.OrderStatus, Mode=TwoWay, 
                            NotifyOnValidationError=true,  ValidatesOnExceptions=true}"/>

                <!-- ScheduleStatus -->
                <Label Grid.Row="16" Grid.Column="0" Content="Schedule Status:"/>
                <ComboBox Grid.Row="16" Grid.Column="2"
                          ItemsSource="{Binding Source={StaticResource ScheduleStatusList}}"
                          SelectedItem="{Binding CurrentOrder.ScheduleStatus, Mode=TwoWay, 
                            NotifyOnValidationError=true,  ValidatesOnExceptions=true}"/>

                <!-- TimeLeftToCompleteOrder -->
                <Label Grid.Row="17" Grid.Column="0" Content="Time Left:"/>
                <TextBox Grid.Row="17" Grid.Column="2"
                         Text="{Binding CurrentOrder.TimeLeftToCompleteOrder, Mode=TwoWay, 
                            NotifyOnValidationError=true,  ValidatesOnExceptions=true,
                    Converter={StaticResource TimeSpanToDaysHoursConverterKey}}"/>

                <!-- כפתור שמירה -->
                <StackPanel Grid.Row="19" Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="{Binding ButtonText}"
                            Width="140" Height="38"
                            Click="btnAddUpdate_Click"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
