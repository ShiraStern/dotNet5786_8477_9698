<Window x:Class="PL.EnterSystemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="כניסה למערכת"
        Height="500"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <!-- רקע כללי -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFEFF7FF" Offset="0"/>
                <GradientStop Color="#FFFFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- אלמנטים דקורטיביים -->
        <Ellipse Width="420" Height="340"
                 Fill="#40CDEAFE"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-100 -120 0 0"/>

        <Ellipse Width="320" Height="260"
                 Fill="#30AED9C7"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0 0 -100 -80"/>

        <!-- כרטיס Login -->
        <Border Width="420"
                Padding="30"
                Background="White"
                CornerRadius="22"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.25"/>
            </Border.Effect>

            <StackPanel>

                <!-- כותרת -->
                <TextBlock Text="מערכת ניהול משלוחים"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#1F4E79"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="כניסה למערכת"
                           FontSize="15"
                           Foreground="#6A8FBF"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,25"/>

                <!-- תעודת זהות -->
                <TextBlock Text="תעודת זהות"
                           Foreground="#4A6FA5"/>
                <TextBox Height="42"
                         Margin="0,6,0,18"
                         FontSize="14"
                         Padding="10"
                         BorderBrush="#BFDFFF"
                         Background="#F7FBFF"
                         Text="{Binding CourierId, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- סיסמה -->
                <TextBlock Text="סיסמה"
                           Foreground="#4A6FA5"/>
                <PasswordBox Height="42"
                             Margin="0,6,0,28"
                             Padding="10"
                             BorderBrush="#BFDFFF"
                             Background="#F7FBFF"
                             PasswordChanged="PasswordBox_PasswordChanged"/>

                <!-- כפתור Login -->
                <Button Content="Login"
                        Height="44"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#7EC8FF"
                        BorderThickness="0"
                        Click="LoginButton_Click"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="22">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>
